#!/bin/bash
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMON_DIR="$DOTFILES_DIR/scripts/common"

echo "=== Dotfiles Bootstrap ==="

case "$(uname -s)" in
Darwin)
    echo "Detected macOS"
    SCRIPTS_DIR="$DOTFILES_DIR/scripts/macos"
    "$SCRIPTS_DIR/brew.sh"
    # Make Homebrew-installed tools available to subsequent scripts
    eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null || true)"
    ;;
Linux)
    echo "Detected Linux"
    if command -v pacman &>/dev/null; then
        SCRIPTS_DIR="$DOTFILES_DIR/scripts/arch"
        "$SCRIPTS_DIR/pacman.sh"
    elif command -v apt-get &>/dev/null; then
        SCRIPTS_DIR="$DOTFILES_DIR/scripts/ubuntu"
        "$SCRIPTS_DIR/apt.sh"
        "$SCRIPTS_DIR/neovim.sh"
        "$SCRIPTS_DIR/rustup.sh"
        "$SCRIPTS_DIR/uv.sh"
        "$SCRIPTS_DIR/opencode.sh"
    else
        echo "Unsupported Linux distribution (no pacman or apt-get found)."
        exit 1
    fi
    ;;
*)
    echo "Unsupported OS: $(uname -s)"
    exit 1
    ;;
esac

"$COMMON_DIR/oh-my-zsh.sh"
"$COMMON_DIR/stow.sh"
"$COMMON_DIR/nvm.sh"

# Set zsh as login shell if it's installed but not the current shell (Linux)
if [[ "$(uname -s)" == Linux ]] && command -v zsh &>/dev/null && [[ "$SHELL" != "$(command -v zsh)" ]]; then
    echo "Setting zsh as login shell..."
    chsh -s "$(command -v zsh)" || echo "Warning: failed to set zsh as login shell. Run manually: chsh -s $(command -v zsh)"
fi

echo ""
echo "=== Bootstrap complete ==="
echo "Restart your terminal or run: exec zsh"
echo ""
echo "Note: set your git identity before committing:"
echo "  git config --global user.name <name> && git config --global user.email <email>"
echo "  (jj falls back to ~/.gitconfig, so a single git config covers both)"
